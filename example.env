# ONLYOFFICE Document Server for FreeBSD (Daemonless)
# Copy to .env and edit.

# Where data lives on the host
CONFIG_LOCATION=/containers/onlyoffice/config
DB_DATA_LOCATION=/containers/onlyoffice/postgres

# PostgreSQL password. Change this to a random password!
DB_PASSWORD=onlyoffice

# Public hostname:port the browser uses to reach the document server
EXAMPLE_SERVER_URL=your-hostname:8080

# Timezone (TZ identifier)
# TZ=UTC
